# Configuração do Firebase
# 1) Console do Firebase > Configurações do projeto > Seus apps (Web): copie o objeto de config.
# 2) As variáveis NEXT_PUBLIC_* vão para o navegador (o Client ID/URL são públicos).
# 3) As credenciais do Admin (servidor) vêm de uma chave de conta de serviço
#    (Configurações do projeto > Contas de serviço > Gerar nova chave privada).
#    NUNCA exponha estas últimas ao cliente.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
