rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Progresso: o aluno lê e escreve apenas o próprio documento.
    // (Neste modo sem funções, a correção é no navegador, então a regra garante o
    // isolamento entre usuários, mas não a veracidade da conclusão.)
    match /progress/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Certificados: conferência pública pelo código (get), sem listagem.
    // Só o próprio dono cria; update/delete negados.
    match /certificates/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.name is string;
      allow update, delete: if false;
    }
  }
}
